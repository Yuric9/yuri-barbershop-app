{
  "name": "yuri-barbershop-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/sites-env.sh -- bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "bash scripts/sites-env.sh -- eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run",
    "cloudflare:types": "wrangler types",
    "cloudflare:migrate": "wrangler d1 migrations apply DB --remote --config dist/server/wrangler.json",
    "cloudflare:deploy": "npm run cloudflare:migrate && wrangler deploy",
    "admin:hash-password": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Gestão Yuri Barbershop"
}
